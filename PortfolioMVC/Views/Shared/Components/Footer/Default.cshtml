@model Personal
<footer id="footer" class="footer dark-background">
    <div class="container">
        <h3 class="sitename">@Model.NameSurname</h3>
        <p>@Model.Description</p>
        <div class="social-links d-flex justify-content-center">
            <a href="@Model.LinkX"><i class="bi bi-twitter-x"></i></a>
            <a href="@Model.LinkFaceBook"><i class="bi bi-facebook"></i></a>
            <a href="@Model.LinkInstagram"><i class="bi bi-instagram"></i></a>
            <a href="@Model.LinkLinkedIn"><i class="bi bi-linkedin"></i></a>
        </div>
        <div class="container">
            <div class="copyright">
                <span>Copyright</span> <strong class="px-1 sitename">2025</strong> <span>All Rights Reserved</span>
            </div>
        </div>
    </div>
</footer>