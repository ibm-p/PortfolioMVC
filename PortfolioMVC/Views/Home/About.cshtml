@using System.Text.RegularExpressions
@model AboutModel
@{
    ViewData["Title"] = "Hakkımda";
}
@{
    string rawPhone = Model.Personal.Phone ?? "";
    string formattedPhone = Regex.Replace(rawPhone, @"(\d{3})(\d{3})(\d{2})(\d{2})", "(0$1) $2 $3 $4");
}


<!-- About Section -->
<section id="about" class="about section" style="margin-top: 82px">
    <h1 class="text-center">
        Hakkımda
    </h1>
    <hr />
    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4 justify-content-center">
            <div class="col-lg-4">
                <img src="@Model.About.LinkPicture" class="img-fluid" alt="">
            </div>
            <div class="col-lg-8 content">
                <h2>@Model.About.Title</h2>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Website:</strong> <span>@Model.About.WebSite</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Phone:</strong> <span>@formattedPhone</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Şehir:</strong> <span>@Model.About.City</span></li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <strong>Yaş:</strong> <span>@Model.About.Age</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Email:</strong> <span>@Model.Personal.Email</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Freelance:</strong> <span>Evet</span></li>
                        </ul>
                    </div>
                </div>
                <p class="py-3">
                    @if (Model.About.Description != null)
                    {
                        @Html.Raw(Model.About.Description)
                    }
                </p>
            </div>
        </div>

    </div>

</section><!-- /About Section -->
<!-- Stats Section -->
<!-- Skills Section -->
<!-- Testimonials Section -->
<section id="testimonials" class="testimonials section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Referanslar</h2>
        <div><span></span> <span class="description-title">Referanslarımı</span> inceleyin</div>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="swiper init-swiper" data-speed="600" data-delay="5000">
            <script type="application/json" class="swiper-config">
                {
                "loop": true,
                "speed": 600,
                "autoplay": {
                "delay": 5000
                },
                "slidesPerView": "auto",
                "pagination": {
                "el": ".swiper-pagination",
                "type": "bullets",
                "clickable": true
                },
                "breakpoints": {
                "320": {
                "slidesPerView": 1,
                "spaceBetween": 40
                },
                "1200": {
                "slidesPerView": 3,
                "spaceBetween": 20
                }
                }
                }
            </script>
            <div class="swiper-wrapper">

                @foreach (var item in Model.References)
                {
                    <div class="swiper-slide">
                        <div class="testimonial-item">
                            <p>
                                <i class=" bi bi-quote quote-icon-left"></i>
                                <span>@item.Description</span>
                                <i class="bi bi-quote quote-icon-right"></i>
                            </p>
                            @if (string.IsNullOrEmpty(item.LinkPicture) == false)
                            {
                                <img src="@item.LinkPicture" class="testimonial-img" alt="">

                            }
                            <h3>@item.Name</h3>
                            @if(string.IsNullOrEmpty(item.Title) == false)
                            {
                                <h4>@item.Title</h4>

                            }
                        </div>
                    </div>

                    <!-- End testimonial item -->
                }


            </div>
            <div class="swiper-pagination"></div>
        </div>

    </div>

</section><!-- /Testimonials Section -->