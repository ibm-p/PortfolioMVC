@model Personal
@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section id="hero" class="hero section dark-background">

    <img src="@Model.LinkPicture" alt="" data-aos="fade-in">

    <div class="container" data-aos="zoom-out" data-aos-delay="100">
        <h2>@Model.NameSurname</h2>
        <p>Ben bir <span class="typed" data-typed-items="@Model.Skills"></span><span class="typed-cursor typed-cursor--blink"></span></p>
        <div class="social-links">
            <a href="@Model.LinkX"><i class="bi bi-twitter-x"></i></a>
            <a href="@Model.LinkFaceBook"><i class="bi bi-facebook"></i></a>
            <a href="@Model.LinkInstagram"><i class="bi bi-instagram"></i></a>
            <a href="@Model.LinkLinkedIn"><i class="bi bi-linkedin"></i></a>
        </div>
    </div>

</section><!-- /Hero Section -->