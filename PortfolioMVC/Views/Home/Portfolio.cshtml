@{
    ViewData["Title"] = "Portföyüm";
}


@model PortfolioModel
<section id="portfolio" class="portfolio section mb-5" style="margin-top: 82px">
    <h1 class="text-center">
        Portföyüm
    </h1>
    <hr />
    <div class="container">

        <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">



            <ul class="portfolio-filters isotope-filters" data-aos="fade-up" data-aos-delay="100">
                <li data-filter="*" class="filter-active">Tümü</li>
                @foreach (var item in Model.Categories)
                {
                    <li data-filter=".@item.Classname">@item.Name</li>
                }

            </ul><!-- End Portfolio Filters -->

            <div class="row gy-4 isotope-container" data-aos="fade-up" data-aos-delay="200">
                @foreach (var item in Model.Portfolios)
                {
                    <div class="col-lg-4 col-md-6 portfolio-item isotope-item @item.Category?.Classname">
                        <div class="portfolio-content h-100">
                            <img src="@item.ImageLink" class="img-fluid" alt="">
                            <div class="portfolio-info">
                                <h4>@item.Category?.Name</h4>
                                <p>@item.Description</p>
                                <a href="@item.ImageLink" title="App 1" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                            </div>
                        </div>
                    </div>

                }
                




            </div><!-- End Portfolio Container -->

        </div>

    </div>

</section><!-- /Portfolio Section -->
