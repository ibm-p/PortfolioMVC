    <script type="text/javascript">
        var funcParamsNames  = undefined;
        var controllerCallback = [];
        angApp.controller('Main', function ($element, $scope, $compile, $http, $window, $sce, $timeout, $templateCache, NgTableParams, $rootScope, $q) {
            //, $uibModal
            $scope.$global = window;
            this.isOpen = false;
            moment.locale('tr');
            let mainScope = $scope;
            $scope.openMenu = function ($mdMenu, ev) {
                $mdMenu.open(ev);
            };
            $scope.$http = $http;
            $scope.$compile = $compile;
            $scope.$$apply = function () {
                if (!this.$$phase) {
                    this.$apply();
                }
            }
            $scope.$$digest = function () {
                if (!this.$$phase) {
                    this.$digest();
                }
            }
            $scope._digestTOObj;
            $scope.$$digestTO = function (ms=100) {
                if ($scope._digestTOObj) {
                    window.clearTimeout($scope._digestTOObj);
                }
                $scope._digestTOObj = setTimeout(function () {
                    $scope.$$digest();
                    $scope._digestTOObj = undefined;
                }, ms)
            }
            if (!funcParamsNames) {
                funcParamsNames = getFunctionParamNames(arguments.callee);
            }
            ApplyAngularCallBacks(controllerCallback, funcParamsNames, arguments);
        })

    </script>

