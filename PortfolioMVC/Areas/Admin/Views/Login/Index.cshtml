@model LoginModel
@{
    Layout = "_Layout_Fixed";
    ViewData["Title"] = "Giriş Yap";
}

<div class="card card-primary card-outline mb-5 mt-5">
    <!--begin::Header-->
    <div class="card-header d-flex justify-content-center"><div class="card-title">Giriş Yap</div></div>
    <!--end::Header-->
    <!--begin::Form-->
    <form asp-action="Index" method="post">
        <!--begin::Body-->
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <input type="text" class="form-control" asp-for="Username" aria-describedby="emailHelp">
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
        <!--end::Body-->
        <!--begin::Footer-->
        <div class="card-footer text-center">
            <button type="submit" class="btn btn-primary" style="min-width:100px;">Giriş</button>
        </div>
        <!--end::Footer-->
    </form>
    <!--end::Form-->
</div>